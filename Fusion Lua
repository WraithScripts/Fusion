-- 0. Big Loading Screen GUI
local function showLoadingGUI(duration)
    pcall(function()
        local existing = CoreGui:FindFirstChild("MoonlightLoadingScreen") or (player and player.PlayerGui and player.PlayerGui:FindFirstChild("MoonlightLoadingScreen"))
        if existing then existing:Destroy() end

        local sg = Instance.new("ScreenGui")
        sg.Name = "MoonlightLoadingScreen"
        sg.DisplayOrder = 999999
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true

        local backdrop = Instance.new("Frame")
        backdrop.Size = UDim2.new(1, 0, 1, 0)
        backdrop.BackgroundColor3 = Color3.fromRGB(8, 12, 24)
        backdrop.BackgroundTransparency = 1
        backdrop.Parent = sg

        local container = Instance.new("Frame")
        container.Size = UDim2.fromOffset(520, 160)
        container.Position = UDim2.new(0.5, 0, 0.5, 0)
        container.AnchorPoint = Vector2.new(0.5, 0.5)
        container.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
        container.BackgroundTransparency = 1
        container.Parent = backdrop

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 18)
        corner.Parent = container

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(59, 130, 246)
        stroke.Thickness = 2.5
        stroke.Transparency = 1
        stroke.Parent = container

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -40, 0, 45)
        title.Position = UDim2.new(0.5, 0, 0.35, 0)
        title.AnchorPoint = Vector2.new(0.5, 0.5)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBold
        title.Text = "LOADING MOONLIGHT SCRIPT..."
        title.TextColor3 = Color3.fromRGB(224, 231, 255)
        title.TextSize = 23
        title.TextTransparency = 1
        title.Parent = container

        local subtitle = Instance.new("TextLabel")
        subtitle.Size = UDim2.new(1, -40, 0, 40)
        subtitle.Position = UDim2.new(0.5, 0, 0.72, 0)
        subtitle.AnchorPoint = Vector2.new(0.5, 0.5)
        subtitle.BackgroundTransparency = 1
        subtitle.Font = Enum.Font.Gotham
        subtitle.Text = "This may take up to 20 seconds depending on what executor you are using"
        subtitle.TextColor3 = Color3.fromRGB(148, 163, 184)
        subtitle.TextSize = 13
        subtitle.TextWrapped = true
        subtitle.TextTransparency = 1
        subtitle.Parent = container

        -- Mount GUI
        local parentTarget = CoreGui
        if not pcall(function() sg.Parent = parentTarget end) then
            sg.Parent = player.PlayerGui
        end

        -- Animate Fade In
        TweenService:Create(backdrop, TweenInfo.new(0.25), {BackgroundTransparency = 0.4}):Play()
        TweenService:Create(container, TweenInfo.new(0.25), {BackgroundTransparency = 0.05}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.1}):Play()
        TweenService:Create(title, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
        TweenService:Create(subtitle, TweenInfo.new(0.25), {TextTransparency = 0}):Play()

        -- Animated loading dots task
        task.spawn(function()
            local dots = {".", "..", "..."}
            local idx = 1
            while sg and sg.Parent do
                title.Text = "LOADING MOONLIGHT SCRIPT" .. dots[idx]
                idx = (idx % #dots) + 1
                task.wait(0.4)
            end
        end)

        -- Auto Cleanup Fade Out
        task.delay(duration or 3.5, function()
            pcall(function()
                if sg and sg.Parent then
                    local t1 = TweenService:Create(backdrop, TweenInfo.new(0.4), {BackgroundTransparency = 1})
                    local t2 = TweenService:Create(container, TweenInfo.new(0.4), {BackgroundTransparency = 1})
                    local t3 = TweenService:Create(stroke, TweenInfo.new(0.4), {Transparency = 1})
                    local t4 = TweenService:Create(title, TweenInfo.new(0.4), {TextTransparency = 1})
                    local t5 = TweenService:Create(subtitle, TweenInfo.new(0.4), {TextTransparency = 1})
                    t1:Play() t2:Play() t3:Play() t4:Play() t5:Play()
                    t1.Completed:Wait()
                    sg:Destroy()
                end
            end)
        end)
    end)
end

