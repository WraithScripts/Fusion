-- Fast Non-Blocking HTTP Fetcher
local httpReq = request or http_request or (syn and syn.request) or (http and http.request)
local function fetchFast(url)
    if type(httpReq) == "function" then
        local ok, res = pcall(function()
            return httpReq({Url = url, Method = "GET"})
        end)
        if ok and res and res.Body and #res.Body > 0 then
            return res.Body
        end
    end
    local ok, body = pcall(function()
        return game:HttpGet(url, true)
    end)
    if ok and type(body) == "string" then
        return body
    end
    return nil
end

